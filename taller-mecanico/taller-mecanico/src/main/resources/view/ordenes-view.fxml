<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.CustomTextField?>
<?import com.taller.mecanico.ui.Paginador?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.taller.mecanico.controller.OrdenesController"
      styleClass="pagina">

    <fx:define>
        <VBox fx:id="panelNuevaOrden" styleClass="drawer"
              prefWidth="460.0" maxWidth="460.0" maxHeight="Infinity">
            <HBox styleClass="drawer-header">
                <StackPane styleClass="drawer-icono"><FontIcon iconLiteral="fth-clipboard"/></StackPane>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="Nueva orden de servicio" styleClass="drawer-titulo"/>
                    <Label text="Registra el ingreso del vehiculo al taller" styleClass="drawer-subtitulo"/>
                </VBox>
                <Button onAction="#onCerrarFormulario" styleClass="flat,button-circle">
                    <graphic><FontIcon iconLiteral="fth-x"/></graphic>
                </Button>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="drawer-scroll" VBox.vgrow="ALWAYS">
                <VBox styleClass="drawer-body">
                    <Label text="VEHICULO" styleClass="seccion-form"/>

                    <VBox styleClass="campo">
                        <Label text="Vehiculo *" styleClass="campo-label"/>
                        <CustomTextField fx:id="txtVehiculo" promptText="Busca por placa o propietario">
                            <left><FontIcon iconLiteral="fth-truck"/></left>
                        </CustomTextField>
                        <Label styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>
                    <Label fx:id="lblPropietario" styleClass="detalle-dato" wrapText="true"
                           visible="false" managed="false"/>

                    <VBox styleClass="campo">
                        <Label text="Kilometraje actual *" styleClass="campo-label"/>
                        <TextField fx:id="txtKilometraje" promptText="Ej. 45200"/>
                        <Label styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>

                    <Label text="TRABAJO" styleClass="seccion-form"/>

                    <VBox styleClass="campo">
                        <Label text="Problema que reporta el cliente *" styleClass="campo-label"/>
                        <TextArea fx:id="txtProblema" prefRowCount="4" wrapText="true"
                                  promptText="Ej. Ruido al frenar y vibracion en el timon"/>
                        <Label styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>

                    <VBox styleClass="campo">
                        <Label text="Mecanico asignado" styleClass="campo-label"/>
                        <ComboBox fx:id="cmbMecanico" maxWidth="Infinity" promptText="Sin asignar"/>
                        <Label styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <HBox styleClass="drawer-footer">
                <Button text="Cancelar" onAction="#onCerrarFormulario" styleClass="button-outlined"/>
                <Button text="Registrar orden" onAction="#onRegistrar" styleClass="accent" defaultButton="true">
                    <graphic><FontIcon iconLiteral="fth-check"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </fx:define>

    <HBox styleClass="pagina-cabecera">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTitulo" text="Ordenes de servicio" styleClass="pagina-titulo"/>
            <Label fx:id="lblSubtitulo" text="Vehiculos que ingresan al taller y su avance"
                   styleClass="pagina-subtitulo"/>
        </VBox>
        <Button fx:id="btnNuevaOrden" text="Nueva orden" onAction="#onNuevaOrden" styleClass="accent,boton-principal">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>

    <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">
        <HBox styleClass="barra-herramientas">
            <CustomTextField fx:id="txtBuscar" promptText="Buscar por codigo, placa o cliente"
                             styleClass="buscador" prefWidth="320.0">
                <left><FontIcon iconLiteral="fth-search"/></left>
            </CustomTextField>
            <ComboBox fx:id="cmbEstado" prefWidth="200.0" promptText="Todos los estados"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnImprimir" text="Imprimir" onAction="#onImprimir" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="fth-printer"/></graphic>
            </Button>
            <Button fx:id="btnAbrir" text="Abrir orden" onAction="#onAbrir" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="fth-external-link"/></graphic>
            </Button>
        </HBox>

        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo"   text="ORDEN"     prefWidth="110.0"/>
                <TableColumn fx:id="colIngreso"  text="INGRESO"   prefWidth="130.0"/>
                <TableColumn fx:id="colVehiculo" text="VEHICULO"  prefWidth="220.0"/>
                <TableColumn fx:id="colCliente"  text="CLIENTE"   prefWidth="200.0"/>
                <TableColumn fx:id="colMecanico" text="MECANICO"  prefWidth="170.0"/>
                <TableColumn fx:id="colEstado"   text="ESTADO"    prefWidth="150.0"/>
                <TableColumn fx:id="colTotal"    text="TOTAL"     prefWidth="110.0"/>
            </columns>
        </TableView>

        <Paginador fx:id="paginador"/>
    </VBox>
</VBox>
