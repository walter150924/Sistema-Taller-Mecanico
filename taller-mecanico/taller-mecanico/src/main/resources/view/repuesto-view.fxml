<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.CustomTextField?>
<?import com.taller.mecanico.ui.Paginador?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.taller.mecanico.controller.RepuestoController"
      styleClass="pagina">

    <fx:define>
        <VBox fx:id="panelFormulario" styleClass="drawer"
              prefWidth="440.0" maxWidth="440.0" maxHeight="Infinity">
            <HBox styleClass="drawer-header">
                <StackPane styleClass="drawer-icono"><FontIcon iconLiteral="fth-package"/></StackPane>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblTituloFormulario" text="Nuevo repuesto" styleClass="drawer-titulo"/>
                    <Label fx:id="lblSubtituloFormulario" text="Agrega un repuesto al catalogo"
                           styleClass="drawer-subtitulo"/>
                </VBox>
                <Button onAction="#onCerrarFormulario" styleClass="flat,button-circle">
                    <graphic><FontIcon iconLiteral="fth-x"/></graphic>
                </Button>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="drawer-scroll" VBox.vgrow="ALWAYS">
                <VBox styleClass="drawer-body">
                    <Label text="DATOS GENERALES" styleClass="seccion-form"/>

                    <VBox styleClass="campo">
                        <Label text="Codigo *" styleClass="campo-label"/>
                        <CustomTextField fx:id="txtCodigoRepuesto" promptText="Ej. PRD-001">
                            <left><FontIcon iconLiteral="fth-hash"/></left>
                        </CustomTextField>
                        <Label styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>

                    <VBox styleClass="campo">
                        <Label text="Nombre *" styleClass="campo-label"/>
                        <TextField fx:id="txtNombre" promptText="Ej. Agua mineral 625 ml"/>
                        <Label styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>

                    <HBox spacing="14.0">
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS" prefWidth="170.0">
                            <Label text="Precio *" styleClass="campo-label"/>
                            <CustomTextField fx:id="txtPrecio" promptText="0.00">
                                <left><Label text="S/" styleClass="prefijo-moneda"/></left>
                            </CustomTextField>
                            <Label styleClass="campo-error" visible="false" managed="false"/>
                        </VBox>
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS" prefWidth="210.0">
                            <Label text="Categoria" styleClass="campo-label"/>
                            <ComboBox fx:id="cmbCategoria" promptText="Sin categoria"
                                      maxWidth="Infinity"/>
                            <Label styleClass="campo-error" visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <Label text="INVENTARIO" styleClass="seccion-form"/>

                    <HBox spacing="14.0">
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS" prefWidth="170.0">
                            <Label text="Stock minimo *" styleClass="campo-label"/>
                            <CustomTextField fx:id="txtStockMinimo" promptText="5">
                                <left><FontIcon iconLiteral="fth-alert-triangle"/></left>
                            </CustomTextField>
                            <Label styleClass="campo-error" visible="false" managed="false"/>
                        </VBox>
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS" prefWidth="210.0">
                            <Label text="Stock actual" styleClass="campo-label"/>
                            <Label fx:id="lblStockActual" styleClass="stock-actual" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <Label text="El stock solo cambia al registrar compras y ventas (ver Inventario)."
                           styleClass="campo-ayuda" wrapText="true"/>

                    <Label text="DETALLE" styleClass="seccion-form"/>

                    <VBox styleClass="campo">
                        <Label text="Descripcion" styleClass="campo-label"/>
                        <TextArea fx:id="txtDescripcion" promptText="Opcional: caracteristicas, presentacion, etc."
                                  prefRowCount="4" wrapText="true"/>
                        <Label styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <HBox styleClass="drawer-footer">
                <Button text="Cancelar" onAction="#onCerrarFormulario" styleClass="button-outlined"/>
                <Button text="Guardar" onAction="#onGuardar" styleClass="accent" defaultButton="true">
                    <graphic><FontIcon iconLiteral="fth-check"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </fx:define>

    <HBox styleClass="pagina-cabecera">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label text="Repuestos" styleClass="pagina-titulo"/>
            <Label text="Gestiona el catalogo, precios y categorias de tus repuestos"
                   styleClass="pagina-subtitulo"/>
        </VBox>
        <Button text="Nuevo repuesto" onAction="#onNuevo" styleClass="accent,boton-principal">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>

    <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">
        <HBox styleClass="barra-herramientas">
            <CustomTextField fx:id="txtBuscar" promptText="Buscar por nombre, codigo o descripcion"
                             styleClass="buscador" prefWidth="340.0">
                <left><FontIcon iconLiteral="fth-search"/></left>
            </CustomTextField>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnEditar" text="Editar" onAction="#onEditar" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
            </Button>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar"
                    styleClass="button-outlined,danger">
                <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
            </Button>
        </HBox>

        <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId"        text="ID"        prefWidth="70.0" maxWidth="90.0"/>
                <TableColumn fx:id="colCodigo"    text="CODIGO"    prefWidth="140.0"/>
                <TableColumn fx:id="colNombre"    text="NOMBRE"    prefWidth="280.0"/>
                <TableColumn fx:id="colCategoria" text="CATEGORIA" prefWidth="180.0"/>
                <TableColumn fx:id="colPrecio"    text="PRECIO"    prefWidth="130.0"/>
                <TableColumn fx:id="colStock"     text="STOCK"     prefWidth="110.0" minWidth="100.0"/>
            </columns>
        </TableView>

        <Paginador fx:id="paginador"/>
    </VBox>
</VBox>
